{
  "name": "farpoint",
  "version": "0.1.0",
  "private": true,
  "description": "External uptime and performance monitoring on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run config:deploy && wrangler deploy --config .wrangler.generated.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "npm run config:deploy && wrangler d1 migrations apply DB --remote --config .wrangler.generated.jsonc",
    "config:deploy": "node scripts/build-deploy-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.147.0"
  }
}
