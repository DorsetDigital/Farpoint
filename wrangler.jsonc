{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "farpoint",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farpoint"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITORS",
        "class_name": "Monitor"
      }
    ]
  },
  "exports": {
    "Monitor": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "CONTROL_PANEL_BASE_URL": "",
    "RAW_RETENTION_DAYS": "30",
    "HOURLY_RETENTION_DAYS": "365",
    "DAILY_RETENTION_DAYS": "1825",
    "INCIDENT_RETENTION_DAYS": "1825",
    "MONITORING_PAUSED": "false"
  }
}
